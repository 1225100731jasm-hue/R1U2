  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();\npm.environment.set(\"token\", datos.accessToken || datos.token);\n\npm.test(\"Login responde 200\", () => {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Devuelve un token\", () => {\n    pm.expect(datos).to.have.property(\"accessToken\");\n});\n\npm.test(\"Responde en menos de 800 ms\", () => {\n    pm.expect(pm.response.responseTime).to.be.below(800);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"emilys\",\"password\":\"emilyspass\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
